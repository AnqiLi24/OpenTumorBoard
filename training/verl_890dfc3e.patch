+def normalize_mm_processor_kwargs(value):
+    """Recursively convert Hydra containers to plain Python containers.
+
+    ``dict(DictConfig)`` only converts the outer mapping, leaving nested
+    ``DictConfig`` values behind. Transformers 5 validates nested image kwargs
+    strictly (notably ``size``), and vLLM must receive the identical plain
+    structure for rollout/actor preprocessing parity.
+    """
+
+    if value is None:
