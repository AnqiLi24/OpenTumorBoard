+"""Utilities for restricting policy-gradient loss to a marked response span."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+
+
+@dataclass(frozen=True)
+class MarkerMaskResult:
+    """A policy mask plus marker-detection diagnostics."""
+
+    mask: torch.Tensor
+    found_start: bool
+    found_end: bool
+    used_tail_fallback: bool
+
+
+def find_token_subsequence(sequence: torch.Tensor, pattern: list[int], start: int = 0) -> int | None:
+    """Return the first exact token-subsequence position at or after ``start``."""
+
+    if sequence.ndim != 1:
+        raise ValueError(f"sequence must be one-dimensional, got shape={tuple(sequence.shape)}")
+    if not pattern:
+        raise ValueError("pattern must contain at least one token")
+    if start < 0:
+        raise ValueError(f"start must be nonnegative, got {start}")
+    stop = sequence.numel() - len(pattern) + 1
+    if start >= stop:
+        return None
+    pattern_tensor = torch.as_tensor(pattern, dtype=sequence.dtype, device=sequence.device)
+    for index in range(start, stop):
+        if torch.equal(sequence[index : index + len(pattern)], pattern_tensor):
+            return index
+    return None
+
+
+def build_marker_policy_mask(
+    response_ids: torch.Tensor,
+    response_mask: torch.Tensor,
+    start_marker_ids: list[int],
+    end_marker_ids: list[int],
+    *,
+    preceding_tokens: int = 0,
+    missing_start_tail_tokens: int = 512,
+) -> MarkerMaskResult:
+    """Mask a marked response span while retaining a bounded malformed-output fallback.
+
+    The selected span includes up to ``preceding_tokens`` valid tokens before the
+    start marker and both marker sequences. If the start marker exists but
+    the end marker does not, the mask extends through the final valid response token.
+    If the start marker is absent, only the last ``missing_start_tail_tokens`` valid
+    tokens participate in policy gradient so malformed samples still supply a signal
+    without supervising the whole response.
+    """
+
+    if response_ids.ndim != 1 or response_mask.ndim != 1:
+        raise ValueError("response_ids and response_mask must be one-dimensional")
+    if response_ids.shape != response_mask.shape:
+        raise ValueError(
+            f"response_ids and response_mask must have the same shape, got "
+            f"{tuple(response_ids.shape)} and {tuple(response_mask.shape)}"
+        )
+    if missing_start_tail_tokens <= 0:
+        raise ValueError("missing_start_tail_tokens must be positive")
+    if preceding_tokens < 0:
+        raise ValueError("preceding_tokens must be nonnegative")
+
+    valid_positions = torch.nonzero(response_mask.to(bool), as_tuple=False).flatten()
+    output = torch.zeros_like(response_mask)
+    if valid_positions.numel() == 0:
+        return MarkerMaskResult(output, False, False, True)
+
+    valid_length = int(valid_positions[-1].item()) + 1
+    valid_ids = response_ids[:valid_length]
+    start_index = find_token_subsequence(valid_ids, start_marker_ids)
+    if start_index is None:
+        fallback_start = max(0, valid_length - missing_start_tail_tokens)
+        output[fallback_start:valid_length] = response_mask[fallback_start:valid_length]
+        return MarkerMaskResult(output, False, False, True)
+
+    end_index = find_token_subsequence(valid_ids, end_marker_ids, start=start_index + len(start_marker_ids))
+    span_end = valid_length if end_index is None else end_index + len(end_marker_ids)
+    span_start = max(0, start_index - preceding_tokens)
+    output[span_start:span_end] = response_mask[span_start:span_end]
+    return MarkerMaskResult(output, True, end_index is not None, False)
