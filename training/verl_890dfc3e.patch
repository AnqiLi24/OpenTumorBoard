diff --git a/verl/models/transformers/vlm_freeze.py b/verl/models/transformers/vlm_freeze.py
new file mode 100644
index 00000000..12243ac6
--- /dev/null
+++ b/verl/models/transformers/vlm_freeze.py
@@ -0,0 +1,105 @@
+"""Utilities for freezing well-defined VLM components before distributed wrapping."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+
+
+@dataclass(frozen=True)
+class FreezeReport:
+    """Summary of parameters frozen by :func:`freeze_vlm_submodules`."""
+
+    tensor_count: int
+    parameter_count: int
+    prefixes: tuple[str, ...]
+
+
+_QWEN_VL_PREFIXES = {
+    "vision": (
+        # Transformers <= 4.x layout.
+        "visual.patch_embed",
+        "visual.blocks",
+        # Transformers 5.x layout.
+        "model.visual.patch_embed",
+        "model.visual.blocks",
+    ),
+    "projector": (
+        "visual.merger",
+        "model.visual.merger",
+    ),
+}
+
+_MODEL_PREFIXES = {
+    "qwen2_vl": _QWEN_VL_PREFIXES,
+    "qwen2_5_vl": _QWEN_VL_PREFIXES,
+}
+
+
+def _matches_prefix(name: str, prefix: str) -> bool:
+    return name == prefix or name.startswith(prefix + ".")
+
+
+def freeze_vlm_submodules(
+    model: torch.nn.Module,
+    *,
+    freeze_vision_tower: bool = False,
+    freeze_multi_modal_projector: bool = False,
+) -> FreezeReport:
+    """Freeze selected VLM components and fail rather than silently matching nothing.
+
+    The operation runs before FSDP/FSDP2 wrapping.  Prefixes intentionally cover
+    both the Transformers 4.x and 5.x Qwen-VL module layouts so checkpoints can be
+    swept without changing the set of trainable parameters across environments.
+    """
+
+    requested = []
+    if freeze_vision_tower:
+        requested.append("vision")
+    if freeze_multi_modal_projector:
+        requested.append("projector")
+    if not requested:
+        return FreezeReport(tensor_count=0, parameter_count=0, prefixes=())
+
+    model_type = getattr(getattr(model, "config", None), "model_type", None)
+    if model_type not in _MODEL_PREFIXES:
+        raise ValueError(
+            f"Freezing VLM components is not defined for model_type={model_type!r}; "
+            f"supported model types: {sorted(_MODEL_PREFIXES)}"
+        )
+
+    prefix_groups = _MODEL_PREFIXES[model_type]
+    active_prefixes = tuple(prefix for group in requested for prefix in prefix_groups[group])
+    matched_by_group = {group: 0 for group in requested}
+    tensor_count = 0
+    parameter_count = 0
+
+    for name, parameter in model.named_parameters():
+        matched_group = next(
+            (
+                group
+                for group in requested
+                if any(_matches_prefix(name, prefix) for prefix in prefix_groups[group])
+            ),
+            None,
+        )
+        if matched_group is None:
+            continue
+        parameter.requires_grad_(False)
+        matched_by_group[matched_group] += 1
+        tensor_count += 1
+        parameter_count += parameter.numel()
+
+    missing = [group for group, count in matched_by_group.items() if count == 0]
+    if missing:
+        raise ValueError(
+            f"Requested VLM freeze groups matched no parameters: {missing}; "
+            f"model_type={model_type!r}, prefixes={active_prefixes}"
+        )
+
+    return FreezeReport(
+        tensor_count=tensor_count,
+        parameter_count=parameter_count,
+        prefixes=active_prefixes,
+    )
