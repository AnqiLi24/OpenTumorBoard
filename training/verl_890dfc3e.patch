diff --git a/verl/trainer/ppo/v1/utils.py b/verl/trainer/ppo/v1/utils.py
index e9dec313..513f5c75 100644
--- a/verl/trainer/ppo/v1/utils.py
+++ b/verl/trainer/ppo/v1/utils.py
@@ -215,3 +215,57 @@ def compute_advantage_for_multi_trajectories(
     data.batch["advantages"] = scores
     data.batch["returns"] = scores
     return data
+
+
+def compute_scalar_component_grpo_advantages(
+    data: DataProto,
+    batch_keys: list[str],
+    component_scores: torch.Tensor,
+    *,
+    num_repeat: int = 1,
+    norm_adv_by_std_in_grpo: bool = True,
+    config: Any = None,
+) -> torch.Tensor:
+    """Normalize one scalar reward component per GRPO group and broadcast it to response tokens.
+
+    This deliberately normalizes each component independently.  Callers can then
+    apply the resulting advantages to different token masks without allowing a
+    high-variance reward component to erase a lower-variance component before
+    the policy loss is formed.
+    """
+
+    if component_scores.ndim != 1 or component_scores.shape[0] != len(data):
+        raise ValueError(
+            "component_scores must have shape (batch_size,), got "
+            f"{tuple(component_scores.shape)} for batch_size={len(data)}"
+        )
+    response_mask = data.batch["response_mask"]
+    response_lengths = response_mask.sum(dim=-1).to(torch.long)
+    if response_mask.shape[-1] == 0:
+        raise ValueError("split component advantages require a nonempty response-token dimension")
+
+    token_level_rewards = torch.zeros_like(response_mask, dtype=torch.float32)
+    row_indices = torch.arange(len(data), device=response_mask.device)
+    # An immediate-EOS rollout has an all-zero response mask.  It must still
+    # contribute its scalar reward to GRPO group normalization, while receiving
+    # no token gradient itself.  Store its scalar in column zero; the core GRPO
+    # routine sums rewards before multiplying the normalized scalar by the mask.
+    reward_indices = torch.clamp(response_lengths - 1, min=0)
+    token_level_rewards[row_indices, reward_indices] = component_scores.to(
+        device=response_mask.device, dtype=torch.float32
+    )
+    component_data = DataProto(
+        batch=data.batch.select("response_mask").clone(),
+        non_tensor_batch={"uid": data.non_tensor_batch["uid"].copy()},
+        meta_info=data.meta_info.copy(),
+    )
+    component_data.batch["token_level_rewards"] = token_level_rewards
+    component_data = compute_advantage_for_multi_trajectories(
+        component_data,
+        batch_keys=batch_keys,
+        adv_estimator=core_algos.AdvantageEstimator.GRPO,
+        num_repeat=num_repeat,
+        norm_adv_by_std_in_grpo=norm_adv_by_std_in_grpo,
+        config=config,
+    )
+    return component_data.batch["advantages"]
